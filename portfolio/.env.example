# ===== NDA password gate =====
# Copy this file to .env.local for local dev, and set the same two variables
# in the Vercel dashboard (Project → Settings → Environment Variables).

# The password you share with clients (over WhatsApp). Pick your own — never
# commit the real one; it belongs in .env.local and in Vercel's env settings.
NDA_PASSWORD=change-me

# Random secret used to sign the 30-minute unlock cookie.
# Generate a fresh one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NDA_SECRET=replace-me-with-a-long-random-string
